# =============================================================================
# TEXT MODEL — Gemini (translation + prompt refinement)
# =============================================================================
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-2.0-flash
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=400

# =============================================================================
# MULTI-AGENT (emotion, semantic, metaphor — via HF Inference API)
# =============================================================================
# Uses the same HF_API_TOKEN as image generation — no extra key needed.
AGENTS_ENABLED=true
EMOTION_AGENT_MODEL=meta-llama/Llama-3.2-3B-Instruct
SEMANTIC_AGENT_MODEL=meta-llama/Llama-3.2-3B-Instruct
METAPHOR_AGENT_MODEL=meta-llama/Llama-3.2-3B-Instruct
AGENT_MAX_TOKENS=350

# =============================================================================
# HUGGING FACE (image generation + agents)
# =============================================================================
# Free token: https://huggingface.co/settings/tokens
HF_API_TOKEN=
HF_REQUEST_TIMEOUT_S=120

# =============================================================================
# IMAGE MODEL
# =============================================================================
IMAGE_MODEL_PROVIDER=huggingface,pollinations
IMAGE_MODEL_NAME=black-forest-labs/FLUX.1-schnell

# Alternative models:
# IMAGE_MODEL_NAME=stabilityai/stable-diffusion-xl-base-1.0
# IMAGE_MODEL_NAME=stabilityai/stable-diffusion-3.5-large

IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024

# =============================================================================
# TRANSLATION
# =============================================================================
TRANSLATION_ENABLED=true
DEFAULT_SOURCE_LANGUAGE=auto

# =============================================================================
# NLP / EXTRACTION
# =============================================================================
USE_EXPANDED_EMOTION_PALETTE=true

# =============================================================================
# SEGMENTATION
# =============================================================================
SEGMENT_ON_EMOTION_SHIFT=true
SEGMENT_ON_ENTITY_SHIFT=true
MAX_SEGMENTS_PER_POEM=5
MIN_LINES_PER_SEGMENT=2

# =============================================================================
# PROMPT REFINEMENT
# =============================================================================
PROMPT_REFINEMENT_ENABLED=true
PROMPT_REFINEMENT_MAX_ROUNDS=10
PROMPT_REFINEMENT_CONVERGENCE_EPSILON=0.01
PROMPT_REFINEMENT_PATIENCE=3
